# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------
# PostgreSQL connection string. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# --- Server -------------------------------------------------------------
PORT=
NODE_ENV=

# The deployed frontend origin. CORS only allows requests from this exact
# origin — never use "*" in production.
FRONTEND_URL=

# --- Auth -----------------------------------------------------------------
# Long, random string used to sign admin session tokens (JWT). Generate
# one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Email (SMTP) -----------------------------------------------------------
# Any standard SMTP provider works (Resend, Postmark, SendGrid SMTP relay,
# Gmail with an app password, etc). Leave blank in development if you don't
# need to test email — the API still works, it just logs a warning and
# skips sending.
#
# EMAIL_PORT controls the TLS mode automatically (src/services/emailService.js
# derives secure/requireTLS from this value — nothing else to change):
#   587 -> STARTTLS (secure: false, requireTLS: true)   <- recommended for Gmail
#   465 -> implicit TLS (secure: true)
# For Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_USER=your Gmail address,
# EMAIL_PASSWORD=a 16-character Gmail "app password" (not your login password).
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Business contact info ---------------------------------------------
# Centralized here so it's never hardcoded across controllers/templates.
# ADMIN_EMAIL receives every new inquiry notification.
ADMIN_EMAIL=
BUSINESS_PHONE=
INSTAGRAM_HANDLE=
INSTAGRAM_URL=
